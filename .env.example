# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# --- Supabase ---------------------------------------------------------------

# Visible depuis le navigateur : c'est normal, ces deux valeurs sont publiques.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ne doit JAMAIS être préfixée par NEXT_PUBLIC_ : cette clé contourne toutes
# les règles d'accès de la base. Elle reste côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session ----------------------------------------------------------------

# Sert à signer le cookie de session. 32 caractères minimum.
# Génère-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Le changer déconnecte tout le monde.
POPOTTE_SESSION_SECRET=

# --- Administration ---------------------------------------------------------

# Code d'accès au panneau d'administration, vérifié côté serveur.
# Sans cette variable, l'administration est inaccessible : il n'y a plus de
# valeur par défaut. Prends autre chose que quatre chiffres.
POPOTTE_ADMIN_CODE=
